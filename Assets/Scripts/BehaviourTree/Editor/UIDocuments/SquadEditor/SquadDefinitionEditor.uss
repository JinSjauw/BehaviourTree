#content-area {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    overflow: hidden;
}

.squad-section-header {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: rgb(200, 200, 200);
}

.squad-section-header--first {
    margin-top: 8px;
}

.squad-section-header--subsequent {
    margin-top: 12px;
}

#section-separator {
    height: 1px;
    background-color: rgb(188, 188, 188);
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 4px;
}

#blackboard-container {
    height: 400px;
    flex-shrink: 0;
    overflow: hidden;
    flex-direction: column;
}

#squad-nav-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 0;
    margin-top: 12px;
}

#create-new-squad-button {
    margin-right: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

#browse-squad-button {
    padding-left: 8px;
    padding-right: 8px;
}

#squad-blackboard-view {
    flex-grow: 1;
    flex-shrink: 1;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

#roles-list {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: 4px;
}

.role-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(56, 56, 56);
}

.role-label {
    flex-grow: 1;
    color: rgb(217, 217, 217);
    -unity-text-align: middle-left;
}

.role-remove-button {
    width: 24px;
    height: 20px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
}

#bindings-add-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    flex-shrink: 0;
}

#bindings-container {
    height: 180px;
    flex-shrink: 0;
    flex-direction: column;
}

#add-binding-group-button {
    padding-left: 8px;
    padding-right: 8px;
}

#binding-groups-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.binding-placeholder {
    color: grey;
    -unity-text-align: middle-center;
    margin-top: 20px;
    font-size: 12px;
    white-space: normal;
}

.binding-group-foldout {
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.binding-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(46, 46, 46);
}

.binding-tree-var {
    flex-grow: 1;
    margin-right: 2px;
}

.binding-arrow {
    width: 20px;
    -unity-text-align: middle-center;
    color: rgb(153, 153, 153);
    margin-left: 2px;
    margin-right: 2px;
}

.binding-squad-var {
    flex-grow: 1;
    margin-right: 2px;
}

.binding-direction-field {
    width: 80px;
    margin-right: 2px;
}

.binding-remove-button {
    width: 24px;
    height: 20px;
    padding-left: 0;
    padding-right: 0;
}

.binding-add-button {
    margin-left: 8px;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

.binding-remove-group-button {
    margin-left: 8px;
    margin-top: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

#sub-section-separator {
    border-top-width: 2px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(187, 187, 187);
    border-right-color: rgb(187, 187, 187);
    border-top-color: rgb(187, 187, 187);
    border-bottom-color: rgb(187, 187, 187);
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 4px;
    width: 98%;
    align-self: center;
}

#content-area > #sections-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport {
    margin-right: 24px;
    margin-left: 24px;
}

#content-area > #sections-scroll > #roles-container > #roles-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport {
    padding-right: 12px;
    padding-left: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

#content-area > #sections-scroll > #bindings-container > #binding-groups-scroll > #unity-content-and-vertical-scroll-container {
    padding-right: 12px;
    padding-left: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.element-container {
    margin-bottom: 10px;
    margin-top: 10px;
}
