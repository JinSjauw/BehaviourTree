.tracked-view-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px 12px;
}





.binding-list-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.header-num {
    width: 24px;
    font-size: 10px;
    color: rgb(140, 140, 140);
}

.header-component {
    font-size: 10px;
    color: rgb(140, 140, 140);
    flex-grow: 0;
}

.header-arrow {
    font-size: 10px;
    color: rgb(140, 140, 140);
    -unity-text-align: middle-center;
    display: flex;
    visibility: visible;
    overflow: hidden;
    width: 25px;
    flex-grow: 0;
    margin-left: 22px;
    margin-right: 22px;
}

.header-variable {
    flex-grow: 0;
    font-size: 10px;
    color: rgb(140, 140, 140);
    overflow: hidden;
    text-overflow: ellipsis;
}

.header-remove {
    width: 24px;
}

.binding-list-view {
    flex-grow: 1;
    flex-shrink: 1;
}

.add-buttons-row {
    flex-direction: row;
    margin-top: 8px;
    flex-shrink: 0;
}

.add-binding-button {
    margin-right: 8px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.scene-object-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    flex-shrink: 1;
}

.scene-object-label {
    margin-right: 8px;
    min-width: 110px;
}

.scene-object-field {
    flex-grow: 0;
    margin-right: 4px;
    overflow: hidden;
    width: 145px;
}

.scene-add-button {
    width: 60px;
}

.empty-state-label {
    flex-grow: 1;
    color: grey;
    -unity-text-align: middle-center;
    font-size: 13px;
    margin-top: 40px;
    display: none;
}

#add-bindings-section {
    flex-grow: 1;
    border-left-color: rgb(80, 80, 80);
    border-right-color: rgb(80, 80, 80);
    border-top-color: rgb(80, 80, 80);
    border-bottom-color: rgb(80, 80, 80);
    border-bottom-width: 1px;
    padding-bottom: 12px;
    margin-bottom: 12px;
}
