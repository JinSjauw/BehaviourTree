<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/BehaviourTree/Editor/UIDocuments/TrackedVariablesView.uss?fileID=7433441132597879392&amp;guid=83b829dc1cba8564694438691ea77ccd&amp;type=3#TrackedVariablesView"/>
    <ui:VisualElement class="tracked-view-root" style="height: auto; align-self: auto;">
        <ui:VisualElement name="add-bindings-section">
            <ui:Label text="Add Tracked Properties" name="title" style="flex-grow: 1; -unity-font-style: bold; font-size: 14px; margin-top: 4px; padding-top: 0; padding-right: 2px; padding-bottom: 0; padding-left: 0; margin-left: 0; margin-right: 0; left: -3px;"/>
            <ui:VisualElement name="button-container" class="add-buttons-row" style="flex-shrink: 1; flex-grow: 0;">
                <ui:Button text="+ Add Binding" name="add-binding-button" class="add-binding-button"/>
                <ui:Button text="+ Add Binding From Scene" name="add-binding-from-scene-button" class="add-binding-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="scene-object-row" class="scene-object-row" style="display: none; overflow: hidden; text-overflow: ellipsis; max-height: none; max-width: initial;">
                <ui:Label text="Scene GameObject:" class="scene-object-label"/>
                <uie:ObjectField name="scene-gameobject-field" class="scene-object-field"/>
                <ui:Button text="Add" name="scene-add-button" class="scene-add-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="list-container" style="flex-grow: 1; border-left-color: rgb(32, 32, 32); border-right-color: rgb(32, 32, 32); border-top-color: rgb(32, 32, 32); border-bottom-color: rgb(32, 32, 32); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;">
            <ui:VisualElement name="list-header" class="binding-list-header">
                <ui:Label text="#" class="header-num"/>
                <ui:Label text="Component / Member" class="header-component"/>
                <ui:Label text="→" class="header-arrow"/>
                <ui:Label text="BB Variable" class="header-variable"/>
                <ui:Label text="" class="header-remove"/>
            </ui:VisualElement>
            <ui:ListView name="binding-list-view" selection-type="None" class="binding-list-view"/>
        </ui:VisualElement>
        <ui:Label name="empty-state-label" class="empty-state-label" style="display: none;"/>
    </ui:VisualElement>
</ui:UXML>
