:root {
}

#role-row-container > ColorField > Label {
    display: none;
}

VisualElement > #foldout-container > #role-foldout > #unity-content {
    margin-top: 0;
    background-color: rgb(56, 56, 56);
    margin-right: 0;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}





VisualElement > #foldout-container > #role-foldout > .unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 1px;
    padding-top: 3px;
}


